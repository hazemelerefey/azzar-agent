{
  "name": "@azzar/analytics",
  "version": "1.6.4",
  "description": "Type-safe analytics for tracking events across providers, built for AZZAR",
  "homepage": "https://hazemelerefy.tech",
  "bugs": {
    "url": "https://github.com/azzar/azzar-analytics/issues/new/choose"
  },
  "repository": {
    "type": "git",
