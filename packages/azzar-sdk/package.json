    "test": "vitest run",
    "test:coverage": "vitest run --coverage --silent='passed-only'"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  }
