{
  "name": "@azzar/icons",
  "version": "6.0.0",
  "description": "Icon library for AZZAR",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./es/*/index.js": "./src/*/index.ts",
    "./es/*/index": "./src/*/index.ts",
    "./es/features/AgentIcon/index.js": "./src/features/AgentIcon/index.tsx",
    "./es/features/IconAvatar/index.js": "./src/features/IconAvatar/index.tsx",
    "./es/features/IconCombine/index.js": "./src/features/IconCombine/index.tsx",
    "./es/features/ModelIcon/index.js": "./src/features/ModelIcon/index.tsx",
    "./es/features/ModelTag/index.js": "./src/features/ModelTag/index.tsx",
    "./es/features/ProviderCombine/index.js": "./src/features/ProviderCombine/index.tsx",
    "./es/features/ProviderIcon/index.js": "./src/features/ProviderIcon/index.tsx",
    "./es/features/*/index.js": "./src/features/*/index.tsx",
    "./es/features/*/index": "./src/features/*/index.tsx",
    "./es/features/getAzzarIconCDN/index.js": "./src/features/getAzzarIconCDN/index.tsx",
    "./es/features/getAzzarIconCDN/index": "./src/features/getAzzarIconCDN/index.tsx",
    "./es/features/getAzzarIconCDN": "./src/features/getAzzarIconCDN/index.tsx",
    "./es/features/agentConfig.js": "./src/features/agentConfig.ts",
    "./es/features/agentConfig": "./src/features/agentConfig.ts",
    "./es/features/modelConfig.js": "./src/features/modelConfig.ts",
    "./es/features/modelConfig": "./src/features/modelConfig.ts",
    "./es/features/providerConfig.js": "./src/features/providerConfig.tsx",
    "./es/features/providerConfig": "./src/features/providerConfig.tsx",
    "./es/features/providerEnum.js": "./src/features/providerEnum.ts",
    "./es/features/providerEnum": "./src/features/providerEnum.ts",
    "./es/toc.js": "./src/toc.ts",
    "./es/toc": "./src/toc.ts",
    "./es/hooks/useFillId.js": "./src/hooks/useFillId.ts",
    "./es/hooks/useFillId": "./src/hooks/useFillId.ts",
    "./es/*": "./src/*/index.ts",
    "./es/*/Avatar": "./src/*/components/Avatar.tsx",
    "./es/*/Brand": "./src/*/components/Brand.tsx",
    "./es/*/BrandColor": "./src/*/components/BrandColor.tsx",
    "./es/*/BrandMono": "./src/*/components/BrandMono.tsx",
    "./es/*/Color": "./src/*/components/Color.tsx",
    "./es/*/Combine": "./src/*/components/Combine.tsx",
    "./es/*/DefaultAvatar": "./src/features/*/DefaultAvatar.tsx",
    "./es/*/DefaultIcon": "./src/features/*/DefaultIcon.tsx",
    "./es/*/Inner": "./src/*/components/Inner.tsx",
    "./es/*/Mono": "./src/*/components/Mono.tsx",
    "./es/*/Morden": "./src/*/components/Morden.tsx",
    "./es/*/Simple": "./src/*/components/Simple.tsx",
    "./es/*/Text": "./src/*/components/Text.tsx",
    "./es/*/TextCn": "./src/*/components/TextCn.tsx",
    "./es/*/TextColor": "./src/*/components/TextColor.tsx",
    "./es/features/*": "./src/features/*",
    "./es/icons": "./src/icons.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "es-toolkit": "^1.52.0",
    "lucide-react": "^0.469.0",
    "polished": "^4.3.1"
  },
  "peerDependencies": {
    "@azzar/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
